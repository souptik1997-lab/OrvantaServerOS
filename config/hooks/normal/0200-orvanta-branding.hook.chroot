#!/bin/sh
# ORVANTA branding. Runs inside the image chroot during 'lb build', after
# config/includes.chroot has been copied in.
set -eu

# /etc/os-release identifies the system as ORVANTA (ID_LIKE=debian). Plasma
# Welcome and "About this System" read NAME and LOGO from it. live-build has
# already made it a regular file with IMAGE_ID/BUILD_ID; keep those fields.
# Debian's own /usr/lib/os-release stays untouched for tools that need it.
grep -q '^ID=debian$' /usr/lib/os-release
image_id="$(sed -n 's/^IMAGE_ID=//p' /etc/os-release)"
build_id="$(sed -n 's/^BUILD_ID=//p' /etc/os-release)"
rm -f /etc/os-release
cat > /etc/os-release <<OSREL
PRETTY_NAME="ORVANTA OS 0.1 (Foundation)"
NAME="ORVANTA OS"
VERSION_ID="0.1"
VERSION="0.1 (Foundation)"
VERSION_CODENAME=trixie
ID=orvanta
ID_LIKE=debian
HOME_URL="https://github.com/souptik1997-lab/OrvantaServerOS"
SUPPORT_URL="https://github.com/souptik1997-lab/OrvantaServerOS"
BUG_REPORT_URL="https://github.com/souptik1997-lab/OrvantaServerOS/issues"
LOGO=orvanta
OSREL
if [ -n "$image_id" ]; then echo "IMAGE_ID=$image_id" >> /etc/os-release; fi
if [ -n "$build_id" ]; then echo "BUILD_ID=$build_id" >> /etc/os-release; fi

# The logo (/usr/share/icons/hicolor/scalable/apps/orvanta.svg) and the
# Plasma Welcome text come from config/includes.chroot; check they arrived.
test -s /usr/share/icons/hicolor/scalable/apps/orvanta.svg
test -s /usr/share/plasma/plasma-welcome/intro-customization.desktop

# ORVANTA global theme (org.orvanta.desktop): colour scheme, wallpaper and
# /etc/xdg/kdeglobals selecting it. /etc/xdg comes before Debian's
# desktop-base settings in XDG_CONFIG_DIRS, so it replaces "Debian Breeze".
test -s /usr/share/plasma/look-and-feel/org.orvanta.desktop/metadata.json
test -s /usr/share/plasma/look-and-feel/org.orvanta.desktop/contents/defaults
test -s /usr/share/color-schemes/OrvantaDark.colors
test -s /usr/share/wallpapers/Orvanta/metadata.json
test -s /usr/share/wallpapers/Orvanta/contents/images/1920x1080.svg
grep -qx 'LookAndFeelPackage=org.orvanta.desktop' /etc/xdg/kdeglobals
# Plasma reads the theme as a package; an existing desktop-base
# /etc/xdg/plasma-workspace/env/env.sh must still list /etc/xdg first.
if [ -f /etc/xdg/plasma-workspace/env/env.sh ]; then
    grep -q 'XDG_CONFIG_DIRS=/etc/xdg:' /etc/xdg/plasma-workspace/env/env.sh
fi
