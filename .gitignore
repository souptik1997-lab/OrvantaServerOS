config/bootstrap
config/chroot
config/common
config/source
config/hooks/live/
config/hooks/normal/*.hook.*
!config/hooks/normal/[0-9]*-orvanta-*.hook.chroot
config/packages.chroot/

# Control Center package build artefacts
orvanta-control-center/debian/.debhelper/
orvanta-control-center/debian/debhelper-build-stamp
orvanta-control-center/debian/files
orvanta-control-center/debian/*.substvars
orvanta-control-center/debian/orvanta-control-center/

__pycache__/
