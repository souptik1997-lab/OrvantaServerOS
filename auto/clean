#!/bin/sh
set -eu

# 'noauto' prevents live-build from re-invoking this auto/clean wrapper
# (without it, 'lb clean' calls auto/clean again and recurses).
lb clean noauto "${@}"

# Remove files generated by 'lb config' so the next run starts from auto/config.
rm -f config/binary config/bootstrap config/chroot config/common config/source
rm -f build.log
